{
  "name": "jarvis",
  "private": true,
  "version": "0.0.0",
  "description": "Saji: an always-on Windows voice assistant with a holographic interface, driven by Claude through a small Node bridge.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "start:writes": "electron . --writes",
    "desktop:shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop-shortcut.ps1",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "45.2.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
